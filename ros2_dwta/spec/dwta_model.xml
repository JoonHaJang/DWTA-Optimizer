<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
  <declaration>
// DWTA realtime C2 pipeline -- timed-automata model (UPPAAL), extended.
//   Threat        : 적 탄도탄 생명주기
//   InterceptorU  : 상층(L-SAM) 유도 채널 슬롯 (인스턴스 수 = CH_U)
//   InterceptorL  : 하층(M-SAM) 유도 채널 슬롯 (인스턴스 수 = CH_L)
//   Planner       : 계획수립 주기 클럭 (PERIOD_P) 모델
// 포대별 채널/탄약을 분리: 상층(ammoU,inflU,CH_U) / 하층(ammoL,inflL,CH_L).

const int MAXT   = 3;
const int CH_U   = 2;   // 상층 유도 채널 (= InterceptorU 인스턴스 수)
const int CH_L   = 2;   // 하층 유도 채널 (= InterceptorL 인스턴스 수)
const int ENTER  = 8;   // 교전영역 진입 시각
const int IMPACT = 30;  // 탄착(누설) 시각
const int FLYOUT_U = 3; // 상층 요격탄 비행시간
const int FLYOUT_L = 2; // 하층 요격탄 비행시간
const int PERIOD_P = 2; // 계획수립 주기

int ammoU = 4, ammoL = 4;
int inflU = 0, inflL = 0;       // 비행중 요격탄 수 (포대 계층별)
int killed = 0, leaked = 0;

chan assign[MAXT];      // 교전배정 (handshake, 어느 계층이든)
chan hit[MAXT];
chan miss[MAXT];
  </declaration>

  <template>
    <name>Threat</name>
    <parameter>const int id</parameter>
    <declaration>clock x;</declaration>
    <location id="id0" x="-560" y="0"><name>Inbound</name>
      <label kind="invariant">x &lt;= IMPACT</label></location>
    <location id="id1" x="-360" y="0"><name>Engageable</name>
      <label kind="invariant">x &lt;= IMPACT</label></location>
    <location id="id2" x="-160" y="0"><name>Engaged</name>
      <label kind="invariant">x &lt;= IMPACT</label></location>
    <location id="id3" x="0" y="-120"><name>Killed</name></location>
    <location id="id4" x="0" y="120"><name>Leaked</name></location>
    <init ref="id0"/>
    <transition><source ref="id0"/><target ref="id1"/>
      <label kind="guard">x &gt;= ENTER</label></transition>
    <transition><source ref="id1"/><target ref="id2"/>
      <label kind="synchronisation">assign[id]?</label></transition>
    <transition><source ref="id1"/><target ref="id4"/>
      <label kind="guard">x &gt;= IMPACT</label>
      <label kind="assignment">leaked++</label></transition>
    <transition><source ref="id2"/><target ref="id3"/>
      <label kind="synchronisation">hit[id]?</label>
      <label kind="assignment">killed++</label></transition>
    <transition><source ref="id2"/><target ref="id1"/>
      <label kind="synchronisation">miss[id]?</label></transition>
    <transition><source ref="id2"/><target ref="id4"/>
      <label kind="guard">x &gt;= IMPACT</label>
      <label kind="assignment">leaked++</label></transition>
  </template>

  <template>
    <name>InterceptorU</name>
    <declaration>clock f; int tgt;</declaration>
    <location id="u0" x="-400" y="0"><name>Idle</name></location>
    <location id="u1" x="-160" y="0"><name>Flying</name>
      <label kind="invariant">f &lt;= FLYOUT_U</label></location>
    <init ref="u0"/>
    <transition><source ref="u0"/><target ref="u1"/>
      <label kind="select">t : int[0,MAXT-1]</label>
      <label kind="guard">ammoU &gt; 0</label>
      <label kind="synchronisation">assign[t]!</label>
      <label kind="assignment">ammoU--, inflU++, tgt = t, f = 0</label></transition>
    <transition><source ref="u1"/><target ref="u0"/>
      <label kind="guard">f &gt;= FLYOUT_U</label>
      <label kind="synchronisation">hit[tgt]!</label>
      <label kind="assignment">inflU--</label></transition>
    <transition><source ref="u1"/><target ref="u0"/>
      <label kind="guard">f &gt;= FLYOUT_U</label>
      <label kind="synchronisation">miss[tgt]!</label>
      <label kind="assignment">inflU--</label></transition>
  </template>

  <template>
    <name>InterceptorL</name>
    <declaration>clock f; int tgt;</declaration>
    <location id="l0" x="-400" y="0"><name>Idle</name></location>
    <location id="l1" x="-160" y="0"><name>Flying</name>
      <label kind="invariant">f &lt;= FLYOUT_L</label></location>
    <init ref="l0"/>
    <transition><source ref="l0"/><target ref="l1"/>
      <label kind="select">t : int[0,MAXT-1]</label>
      <label kind="guard">ammoL &gt; 0</label>
      <label kind="synchronisation">assign[t]!</label>
      <label kind="assignment">ammoL--, inflL++, tgt = t, f = 0</label></transition>
    <transition><source ref="l1"/><target ref="l0"/>
      <label kind="guard">f &gt;= FLYOUT_L</label>
      <label kind="synchronisation">hit[tgt]!</label>
      <label kind="assignment">inflL--</label></transition>
    <transition><source ref="l1"/><target ref="l0"/>
      <label kind="guard">f &gt;= FLYOUT_L</label>
      <label kind="synchronisation">miss[tgt]!</label>
      <label kind="assignment">inflL--</label></transition>
  </template>

  <template>
    <name>Planner</name>
    <declaration>clock cp;</declaration>
    <location id="p0" x="0" y="0"><name>Tick</name>
      <label kind="invariant">cp &lt;= PERIOD_P</label></location>
    <init ref="p0"/>
    <!-- 주기 클럭: 반드시 PERIOD_P 마다 발화 (불변식 cp<=PERIOD_P + 가드 cp>=PERIOD_P) -->
    <transition><source ref="p0"/><target ref="p0"/>
      <label kind="guard">cp &gt;= PERIOD_P</label>
      <label kind="assignment">cp = 0</label></transition>
  </template>

  <system>
T0 = Threat(0); T1 = Threat(1); T2 = Threat(2);
U0 = InterceptorU(); U1 = InterceptorU();   // CH_U = 2 상층 채널
L0 = InterceptorL(); L1 = InterceptorL();   // CH_L = 2 하층 채널
P  = Planner();
system T0, T1, T2, U0, U1, L0, L1, P;
  </system>

  <queries>
    <query><formula>A[] not deadlock</formula>
      <comment>교착 없음</comment></query>
    <query><formula>A[] ammoU &gt;= 0 &amp;&amp; ammoL &gt;= 0</formula>
      <comment>계층별 잔여탄 음수 불가</comment></query>
    <query><formula>A[] inflU &gt;= 0 &amp;&amp; inflU &lt;= CH_U</formula>
      <comment>상층 비행 요격탄 ≤ 상층 유도 채널</comment></query>
    <query><formula>A[] inflL &gt;= 0 &amp;&amp; inflL &lt;= CH_L</formula>
      <comment>하층 비행 요격탄 ≤ 하층 유도 채널</comment></query>
    <query><formula>A[] P.cp &lt;= PERIOD_P</formula>
      <comment>계획수립 주기 보장: 클럭이 주기를 초과하지 않음 (데드라인)</comment></query>
    <query><formula>A&lt;&gt; (T0.Killed || T0.Leaked)</formula>
      <comment>모든 위협은 결국 종결 (라이브니스)</comment></query>
    <query><formula>E&lt;&gt; killed == MAXT</formula>
      <comment>전량 요격 가능한 실행 존재</comment></query>
    <query><formula>E&lt;&gt; (inflU &gt; 0 &amp;&amp; inflL &gt; 0)</formula>
      <comment>상·하층 동시 교전(둘 다 비행중)이 가능</comment></query>
  </queries>
</nta>
