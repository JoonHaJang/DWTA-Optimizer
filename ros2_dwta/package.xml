<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dwta_ros2</name>
  <version>0.1.0</version>
  <description>
    Realtime DWTA (Dynamic Weapon-Target Assignment) C2 pipeline modelled as
    independent ROS2 node loops: radar/early-warning -> threat assessment ->
    engageability -> WTA planning -> launcher, with a deterministic in-process
    shim so the same node code runs without a ROS2 install.
  </description>
  <maintainer email="cyber040946@gmail.com">DWTA Optimizer</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- For a real deployment, depend on a dwta_msgs interface package built from
       the .msg files in ros2_dwta/msg/ (replace the PoC dataclasses). -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
